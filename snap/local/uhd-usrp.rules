#
# udev rules for USB-attached USRPs (B100/B200/B210/B2xxmini, USRP1).
#
# Copied verbatim from uhd-host's uhd-usrp.rules
# (Copyright 2011,2015 Ettus Research LLC; Copyright 2018 Ettus Research,
# a National Instruments Company; SPDX-License-Identifier: GPL-3.0-or-later).
#
# WHY THIS IS SHIPPED SEPARATELY
#
# The `raw-usb` snap interface lets the confined process reach /dev/bus/usb,
# but snapd cannot change the *ownership or mode* of host device nodes. Without
# a rule granting access, opening the radio fails with LIBUSB_ERROR_ACCESS even
# with the interface connected. Normally uhd-host installs this rule on the
# host; a snap user has no uhd-host installed, hence this copy.
#
# INSTALL ON THE HOST (once):
#
#   sudo cp /snap/ngscope/current/etc/udev/rules.d/uhd-usrp.rules \
#           /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Then unplug and replug the USRP. MODE:="0666" means no group membership is
# required. Ethernet USRPs (X300/X310/X410) do not need this file at all.
#

#USRP1
SUBSYSTEMS=="usb", ATTRS{idVendor}=="fffe", ATTRS{idProduct}=="0002", MODE:="0666"

#B100
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2500", ATTRS{idProduct}=="0002", MODE:="0666"

#B200
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2500", ATTRS{idProduct}=="0020", MODE:="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2500", ATTRS{idProduct}=="0021", MODE:="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="2500", ATTRS{idProduct}=="0022", MODE:="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3923", ATTRS{idProduct}=="7813", MODE:="0666"
SUBSYSTEMS=="usb", ATTRS{idVendor}=="3923", ATTRS{idProduct}=="7814", MODE:="0666"
