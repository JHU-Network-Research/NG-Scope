#!/usr/bin/env bash
# Launch the IMSIGuard GUI, creating its virtualenv on first run.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$HERE/.venv"; PY="$VENV/bin/python"
# --system-site-packages: pywebview's GTK backend needs the system PyGObject (python3-gi).
[ -x "$PY" ] || { echo "Creating virtualenv in $VENV ..."; python3 -m venv --system-site-packages "$VENV"; }
if ! "$PY" -c "import webview, pandas, pb_amarder" >/dev/null 2>&1; then
  echo "Installing dependencies ..."
  "$PY" -m pip install --quiet --upgrade pip
  "$PY" -m pip install --quiet -r "$HERE/requirements.txt"
fi
if ! "$PY" -c "import gi" >/dev/null 2>&1; then
  echo "error: PyGObject missing. On Debian/Ubuntu: sudo apt install python3-gi gir1.2-webkit2-4.1" >&2; exit 1
fi
exec env PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}" "$PY" -m imsiguard_gui "$@"
